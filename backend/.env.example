BURNOUT_API_BASE_URL=https://your-railway-backend.up.railway.app
BURNOUT_USER_ID=shaun
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password
GARMIN_TOKEN_STORE=/data/.garth
GARMIN_DAYS_BACK=7
SYNC_OUTPUT_JSON=sync_result.json

# Automatic sync from inside FastAPI (no manual command runs)
GARMIN_AUTO_SYNC_ENABLED=true
GARMIN_AUTO_SYNC_INTERVAL_MINUTES=180
GARMIN_AUTO_SYNC_RUN_ON_STARTUP=true

# Groq LLM (optional — enables personalized AI chatbot replies)
# Get a free key at https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
